# ==========================================
# Variables de entorno - JM Publicity Sound Backend
# Copiar este archivo como ".env" y completar con los valores reales.
# NUNCA subir el archivo ".env" real al repositorio.
# ==========================================

# Cadena de conexión a la base de datos PostgreSQL (usada por Prisma).
# Formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL="postgresql://usuario:password@localhost:5432/jm_publicity_sound"

# Clave secreta usada para firmar y verificar los tokens JWT de autenticación.
# Debe ser una cadena larga y aleatoria, distinta en cada entorno (dev/prod).
JWT_SECRET="cambia-esta-clave-por-una-segura"

# Credenciales de Cloudinary, usadas para subir y gestionar imágenes.
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# API key de Resend (https://resend.com/api-keys), usada para enviar la
# factura por correo al cliente. Se obtiene desde el dashboard de Resend,
# dentro de la cuenta del negocio (Settings > API Keys).
RESEND_API_KEY="re_tu_api_key"

# Remitente con el que se envía la factura. Mientras no se verifique un
# dominio propio en Resend (Settings > Domains), solo se puede enviar desde
# su dirección de prueba ("onboarding@resend.dev") y únicamente al correo
# con el que te registraste en Resend. Cuando se verifique un dominio
# propio, cambiar esto a algo como "JM Publicity Sound <facturas@jmpublicitysound.com>".
RESEND_FROM_EMAIL="JM Publicity Sound <onboarding@resend.dev>"

# Puerto en el que escuchará el servidor Express.
PORT=4000

# URL del frontend permitida para las peticiones CORS.
FRONTEND_URL="http://localhost:5173"
